<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Steam2Browser</RootNamespace>
    <AssemblyName>steam2browser</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <!-- Not a single file: see the release workflow for why. -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <!--
    Identity, in the Win32 version resource every Windows executable carries.

    Without this the fields are filled in from the assembly name, so the file claimed to be produced
    by "steam2browser", to be a product called "steam2browser", described as "steam2browser", with
    an empty copyright and a version of 1.0.0.0 that never changed between releases. Real software
    does not look like that, and unsigned software with no identity is a large part of what a
    reputation engine has to go on: Kaspersky's UDS heuristics flagged the release as
    UDS:Trojan.Win64.SBadur.gen, which is a cloud verdict on behaviour and reputation rather than a
    signature match on anything in the file.

    This is not a cure on its own — that is an Authenticode signature, which costs money and an
    identity check — but it removes one of the reasons to be suspicious, and it makes the version in
    the file agree with the release it came from. The release workflow passes the tag in as Version.
  -->
  <PropertyGroup>
    <Company>extremebleem</Company>
    <Authors>extremebleem</Authors>
    <Product>Steam2 Downloader</Product>
    <!-- FileDescription in the Win32 resource comes from this, not from Description. -->
    <AssemblyTitle>Steam2 Downloader</AssemblyTitle>
    <Description>Browses, downloads and extracts depots from the terarelease Steam2 archive.</Description>
    <Copyright>Copyright (c) extremebleem. MIT licensed.</Copyright>
    <PackageProjectUrl>https://github.com/extremebleem/steam2_downloader</PackageProjectUrl>
    <RepositoryUrl>https://github.com/extremebleem/steam2_downloader</RepositoryUrl>

    <!-- Overridden by the release build with the tag it is about to publish. -->
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.0" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot/**/*" />
    <EmbeddedResource Include="depotkeys.txt" LogicalName="Steam2Browser.depotkeys.txt" />

    <!--
      The names the archive cannot tell you itself. depot_labels.tsv puts a product name on nearly
      every depot and came from a third-party repository; names.jsonl is what this app worked out by
      reading the manifest inside 4 879 depots' blobs. Both used to be fetched or derived on demand,
      which needed the mirrors. With those gone, re-deriving names.jsonl would mean pulling 4 879
      depots' blobs out of the swarm one at a time, so it ships instead.
    -->
    <EmbeddedResource Include="depot_labels.tsv" LogicalName="Steam2Browser.depot_labels.tsv" />
    <EmbeddedResource Include="names.jsonl" Condition="Exists('names.jsonl')" LogicalName="Steam2Browser.names.jsonl" />

    <!--
      The catalog: every file in the archive with its dates and sizes. It used to be built from the
      mirrors on each release and left out of the repository; they have closed, so it is committed
      and this is the only copy there will be.
    -->
    <EmbeddedResource Include="index.bin" Condition="Exists('index.bin')" LogicalName="Steam2Browser.index.bin" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../steam2.torrent" Link="steam2.torrent"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The upstream repo has no tags or releases, so "is there a newer version" is answered by
    comparing the newest commit time on GitHub against when this binary was built.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildTimeUtc" Value="$([System.DateTime]::UtcNow.ToString('O'))" />
    <AssemblyMetadata Include="UpdateRepo" Value="extremebleem/steam2_downloader" />
  </ItemGroup>

</Project>
