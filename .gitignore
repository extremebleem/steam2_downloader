# build output
bin/
obj/
release/
out/
publish/
*.zip

# everything the app writes at runtime
steam2info/
archive/
extracted/
index/
torrent-data/
# Ignored where the app writes them at runtime, but the copies in Steam2Browser/
# are committed and embedded: the mirrors they were derived from are gone.
**/steam2info/names.jsonl
settings.json
**/steam2info/depot_labels.tsv

# partially downloaded files and the marker a segmented download leaves behind
*.part
*.part.segmented

# scratch directories used for download speed testing
.speed-test*/

# archive index files — ~31 MB, and the app fetches them from a mirror on first run.
# NOTE: these are still tracked from an earlier commit, so these lines do nothing until
# they are untracked:  git rm --cached blobs.sha256 blobs_dates.txt dats.sha256 dats_dates.txt
dats_dates.txt
blobs_dates.txt
dats.sha256
blobs.sha256

# catalog snapshot embedded at build time — CI regenerates it on every release
# index.bin is committed now: the mirrors it was built from are gone, so it
# cannot be regenerated. It is the catalog.

.vs/
.idea/
*.user
trackers_from_torrent.txt
